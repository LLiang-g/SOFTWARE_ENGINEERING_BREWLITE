@startuml
title Quan hệ dữ liệu đặt hàng và giữ nguyên liệu
top to bottom direction
hide methods
hide circle
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam linetype polyline
skinparam nodesep 80
skinparam ranksep 60
skinparam classAttributeIconSize 0
class Product {
 id: Int
 name: String
 price: Int
}
class Ingredient {
 id: Int
 unit: String
 stock: Int
}
class Recipe {
 productId: Int
 ingredientId: Int
 quantity: Int
 scalesWithSize: Boolean
 .. Ràng buộc ..
 Unique(productId, ingredientId)
 quantity > 0
}
class ToppingRecipe {
 toppingCode: String
 ingredientId: Int
 quantity: Int
}
class Order {
 id: Int
 status: OrderStatus
 reservationExpiresAt: DateTime?
 reservationExpiredAt: DateTime?
}
class OrderItem {
 productId: Int
 size: Size
 toppings: String[]
 qty: Int
}
class OrderInventoryReservation {
 orderId: Int
 ingredientId: Int
 quantity: Int
 releasedAt: DateTime?
 .. Snapshot ..
 Unique(orderId, ingredientId)
 Lượng nguyên liệu đã giữ lúc đặt
}
class OrderCreateRequest {
 userId: Int
 idempotencyKey: String
 requestHash: String
 orderId: Int?
}
OrderCreateRequest "0..1" -right- "0..1" Order
Order "1" *-down- "1..*" OrderItem
Order "1" -down- "0..*" OrderInventoryReservation
OrderItem "0..*" -down- "1" Product
OrderInventoryReservation "0..*" -down- "1" Ingredient
Product "1" -down- "0..*" Recipe
Ingredient "1" -down- "0..*" Recipe
Ingredient "1" -down- "0..*" ToppingRecipe
OrderItem -[hidden]right- OrderInventoryReservation
Product -[hidden]right- Ingredient
Recipe -[hidden]right- ToppingRecipe
@enduml
