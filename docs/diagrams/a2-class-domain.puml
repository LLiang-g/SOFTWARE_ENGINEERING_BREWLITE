@startuml
title Miền dữ liệu lõi - thuộc tính, bội số và trạng thái
top to bottom direction
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam classAttributeIconSize 0
hide methods
class User {
 id: Int
 email: String {unique}
 passwordHash: String
 role: Role
 loyaltyPoints: Int
}
class Product {
 id: Int
 name: String
 price: Int
 imageUrl: String
}
class Order {
 id: Int
 userId: Int
 status: OrderStatus
 total: Int
 discount: Int
 createdAt: DateTime
}
class OrderItem {
 id: Int
 productId: Int
 size: Size
 toppings: String[]
 qty: Int
 lineTotal: Int
}
class Payment {
 id: Int
 idempotencyKey: String {unique}
 amount: Int
 method: PaymentMethod
}
class "Promotion\n(model Voucher)" as Promotion {
 id: Int
 code: String {unique}
 discountPercent: Int
 expiresAt: DateTime
 active: Boolean
}
class LoyaltyTransaction {
 id: Int
 points: Int
 type: LoyaltyTransactionType
 createdAt: DateTime
}
enum OrderStatus {
 PENDING
 PAYMENT_FAILED
 PAID
 PREPARING
 READY
 COMPLETED
 CANCELLED
}
enum PaymentMethod {
 WALLET
 CARD
 VNPAY
}
enum Size {
 S
 M
 L
}
enum Role {
 CUSTOMER
 BARISTA
}
enum LoyaltyTransactionType {
 EARN
 REDEEM
}
User "1" -- "0..*" Order : đặt
Order "1" *-- "1..*" OrderItem : chứa
Product "1" -- "0..*" OrderItem : được chọn
Order "1" -- "0..*" Payment : ghi khoản thu
Promotion "0..1" -- "0..*" Order : áp dụng
User "1" -- "0..*" LoyaltyTransaction : biến động điểm
Order "0..1" -- "0..*" LoyaltyTransaction : nguồn phát sinh
Order ..> OrderStatus
Payment ..> PaymentMethod
OrderItem ..> Size
User ..> Role
LoyaltyTransaction ..> LoyaltyTransactionType
note bottom of Promotion
 Promotion là khái niệm miền khuyến mãi;
 schema/code hiện thực bằng Voucher.
end note
@enduml
