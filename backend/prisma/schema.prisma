generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Size {
  S
  M
  L
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
  VNPAY
}

enum VnpayAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REVIEW
}

enum Role {
  CUSTOMER
  BARISTA
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
}

model Product {
  id       Int         @id @default(autoincrement())
  name     String
  price    Int
  imageUrl String
  items    OrderItem[]
  recipes  Recipe[]
}

// Nguyên liệu trong kho. stock tính theo đơn vị nhỏ nhất (g, ml, cái) và không bao giờ âm.
model Ingredient {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  unit    String
  stock   Int      @default(0)
  recipes Recipe[]
  reservations OrderInventoryReservation[]
}

// Công thức món: một dòng cho mỗi nguyên liệu, quantity là lượng dùng cho một ly.
// Số ly còn lại của món không lưu mà tính từ kho nguyên liệu qua các dòng này.
model Recipe {
  id           Int @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Int

  product    Product    @relation(fields: [productId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(CUSTOMER)
  loyaltyPoints       Int                  @default(0)
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  orderCreateRequests OrderCreateRequest[]
  paymentStartRequests PaymentStartRequest[]
  paymentAudits PaymentAudit[]
}

model Voucher {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  discountPercent Int
  expiresAt       DateTime
  active          Boolean   @default(true)
  orders          Order[]
}

model Order {
  creditApplied Int @default(0)
  exchangeRequests OrderExchange[] @relation("ExchangeSource")
  replacementFor OrderExchange? @relation("ExchangeReplacement")
  id        Int         @id @default(autoincrement())
  userId    Int
  status    OrderStatus @default(PENDING)
  total     Int
  discount  Int         @default(0)
  voucherId Int?
  createdAt DateTime    @default(now())

  user     User        @relation(fields: [userId], references: [id])
  voucher  Voucher?    @relation(fields: [voucherId], references: [id])
  items    OrderItem[]
  payments Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  inventoryReservations OrderInventoryReservation[]
  createRequest OrderCreateRequest?
  vnpayAttempts VnpayAttempt[]
}

// Key thuộc một khách hàng, không thuộc một tiến trình backend.
model OrderCreateRequest {
  userId         Int
  idempotencyKey String   @db.VarChar(100)
  requestHash    String   @db.Char(64)
  orderId        Int?     @unique
  createdAt      DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([userId, idempotencyKey])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  size      Size
  toppings  String[] @default([])
  qty       Int
  lineTotal Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  idempotencyKey String        @unique
  amount         Int
  method         PaymentMethod
  createdAt      DateTime      @default(now())
  vnpayAttemptId Int?          @unique

  order Order @relation(fields: [orderId], references: [id])
  vnpayAttempt VnpayAttempt? @relation(fields: [vnpayAttemptId], references: [id], onDelete: Restrict)
}

model VnpayAttempt {
  refundCase PaymentRefundCase?
  id                 Int @id @default(autoincrement())
  orderId            Int
  txnRef             String @unique @db.VarChar(32)
  amount             Int
  status             VnpayAttemptStatus @default(PENDING)
  paymentUrl         String
  merchantCode       String
  createDate         String @db.VarChar(14)
  expiresAt          DateTime
  providerTxnNo      String? @unique
  responseCode       String?
  transactionStatus  String?
  paidAt             DateTime?
  reviewReason       String?
  lastCheckedAt      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment?
  requests PaymentStartRequest[]
  audits PaymentAudit[]

  @@index([orderId, createdAt])
}

model PaymentStartRequest {
  userId Int
  key String @db.VarChar(100)
  attemptId Int
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempt VnpayAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@id([userId, key])
}

model PaymentAudit {
  id Int @id @default(autoincrement())
  attemptId Int
  actorId Int?
  action String @db.VarChar(40)
  note String @db.VarChar(1000)
  createdAt DateTime @default(now())
  attempt VnpayAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([attemptId, createdAt])
}

model OrderInventoryReservation {
  id           Int       @id @default(autoincrement())
  orderId      Int
  ingredientId Int
  quantity     Int
  releasedAt   DateTime?

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([orderId, ingredientId])
  @@index([ingredientId])
}

// Sổ cái điểm thưởng: mỗi lần cộng hoặc trừ điểm là một dòng, points dương là cộng.
model LoyaltyTransaction {
  id           Int                    @id @default(autoincrement())
  userId       Int
  orderId      Int?
  type         LoyaltyTransactionType
  points       Int
  balanceAfter Int
  createdAt    DateTime               @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@unique([orderId, type])
  @@index([userId, createdAt])
}

enum ExchangeStatus {
  WITHDRAWN
  REQUESTED
  APPROVED
  REJECTED
}
enum RefundCaseStatus {
  OPEN
  PROCESSING
  COMPLETED
}
model OrderExchange {
  quotedTotal Int?
  quotedLines Json?
  id Int @id @default(autoincrement())
  sourceOrderId Int
  replacementOrderId Int? @unique
  key String @db.VarChar(100)
  requestHash String @db.Char(64)
  items Json
  reason String @db.VarChar(1000)
  status ExchangeStatus @default(REQUESTED)
  version Int @default(0)
  decisionNote String? @db.VarChar(1000)
  decidedBy Int?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  sourceOrder Order @relation("ExchangeSource", fields:[sourceOrderId], references:[id], onDelete:Restrict)
  replacementOrder Order? @relation("ExchangeReplacement", fields:[replacementOrderId], references:[id], onDelete:Restrict)
  @@unique([sourceOrderId,key])
}
model PaymentRefundCase {
  id Int @id @default(autoincrement())
  attemptId Int @unique
  amount Int
  status RefundCaseStatus @default(OPEN)
  version Int @default(0)
  handledBy Int?
  reference String? @unique @db.VarChar(200)
  note String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  completedAt DateTime?
  attempt VnpayAttempt @relation(fields:[attemptId], references:[id], onDelete:Restrict)
}
