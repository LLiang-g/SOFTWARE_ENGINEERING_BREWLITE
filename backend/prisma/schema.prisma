generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Size {
  S
  M
  L
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum Role {
  CUSTOMER
  BARISTA
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
}

model Product {
  id       Int         @id @default(autoincrement())
  name     String
  price    Int
  imageUrl String
  items    OrderItem[]
  recipes  Recipe[]
}

// Nguyên liệu trong kho. stock tính theo đơn vị nhỏ nhất (g, ml, cái) và không bao giờ âm.
model Ingredient {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  unit    String
  stock   Int      @default(0)
  recipes Recipe[]
  reservations OrderInventoryReservation[]
}

// Công thức món: một dòng cho mỗi nguyên liệu, quantity là lượng dùng cho một ly.
// Số ly còn lại của món không lưu mà tính từ kho nguyên liệu qua các dòng này.
model Recipe {
  id           Int @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Int

  product    Product    @relation(fields: [productId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(CUSTOMER)
  loyaltyPoints       Int                  @default(0)
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Voucher {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  discountPercent Int
  expiresAt       DateTime
  active          Boolean   @default(true)
  orders          Order[]
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  status    OrderStatus @default(PENDING)
  total     Int
  discount  Int         @default(0)
  voucherId Int?
  createdAt DateTime    @default(now())

  user     User        @relation(fields: [userId], references: [id])
  voucher  Voucher?    @relation(fields: [voucherId], references: [id])
  items    OrderItem[]
  payments Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  inventoryReservations OrderInventoryReservation[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  size      Size
  toppings  String[] @default([])
  qty       Int
  lineTotal Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  idempotencyKey String        @unique
  amount         Int
  method         PaymentMethod
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model OrderInventoryReservation {
  id           Int       @id @default(autoincrement())
  orderId      Int
  ingredientId Int
  quantity     Int
  releasedAt   DateTime?

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([orderId, ingredientId])
  @@index([ingredientId])
}

// Sổ cái điểm thưởng: mỗi lần cộng hoặc trừ điểm là một dòng, points dương là cộng.
model LoyaltyTransaction {
  id           Int                    @id @default(autoincrement())
  userId       Int
  orderId      Int?
  type         LoyaltyTransactionType
  points       Int
  balanceAfter Int
  createdAt    DateTime               @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@unique([orderId, type])
  @@index([userId, createdAt])
}
